<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      S6580 / CA1305: format-provider on DateTimeOffset.Parse. Test code uses hardcoded
      ISO-8601 literals where culture cannot affect parsing; suppress to keep test files
      legible without a CultureInfo argument on every call.
      S927: parameter names in test fakes intentionally diverge from interface decls
      (typically `_` for discarded params, short names for legibility).
    -->
    <NoWarn>$(NoWarn);S6580;CA1305;S927</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Network\Modules.Network.Domain\Modules.Network.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Network\Modules.Network.Application\Modules.Network.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Network\Modules.Network.Infrastructure\Modules.Network.Infrastructure.csproj" />
    <!-- Stage 2 lives in Ai.Infrastructure (validators, analyzer wrapper, heuristic fallback).
         Reference here so the same test project can exercise both Network and Ai pipeline pieces.
         If Ai-specific tests grow large, split them into tests/Modules.Ai.UnitTests/. -->
    <ProjectReference Include="..\..\src\Modules\Ai\Modules.Ai.Infrastructure\Modules.Ai.Infrastructure.csproj" />
    <!-- Stage-4 dedup lives in Alerts.Domain + Alerts.Application + Alerts.Infrastructure. -->
    <ProjectReference Include="..\..\src\Modules\Alerts\Modules.Alerts.Domain\Modules.Alerts.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Alerts\Modules.Alerts.Application\Modules.Alerts.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Alerts\Modules.Alerts.Infrastructure\Modules.Alerts.Infrastructure.csproj" />
  </ItemGroup>

</Project>
