<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <NoWarn>$(NoWarn);SKEXP0010;SKEXP0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.DeepDev.TokenizerLib" Version="1.3.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <!-- IHttpClientFactory + AddHttpClient<TClient>() — needed by the OSM layer to talk to
         Nominatim / Overpass. Other modules don't make outbound HTTP calls so this dependency
         is scoped to the AI infrastructure project. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.75.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.AzureOpenAI" Version="1.75.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Pgvector" Version="0.3.1" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.2" />
    <!-- Pure-managed PDF text extraction (Apache 2.0). Used by DefaultDocumentTextExtractor
         when ManagedDocument.ContentType is application/pdf. -->
    <PackageReference Include="PdfPig" Version="0.1.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Application\Application.csproj" />
    <ProjectReference Include="..\..\..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\..\Network\Modules.Network.Api\Modules.Network.Api.csproj" />
    <ProjectReference Include="..\..\Network\Modules.Network.Application\Modules.Network.Application.csproj" />
    <ProjectReference Include="..\..\Alerts\Modules.Alerts.Api\Modules.Alerts.Api.csproj" />
    <ProjectReference Include="..\..\Analytics\Modules.Analytics.Api\Modules.Analytics.Api.csproj" />
    <ProjectReference Include="..\..\Energy\Modules.Energy.Api\Modules.Energy.Api.csproj" />
    <ProjectReference Include="..\Modules.Ai.Application\Modules.Ai.Application.csproj" />
    <!-- Composition root: the only project permitted to reference the MAF agent layer (Phase 2 §4.1). -->
    <ProjectReference Include="..\Modules.Ai.Agents\Modules.Ai.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modules.Network.UnitTests" />
    <InternalsVisibleTo Include="BaselineCapture" />
  </ItemGroup>

</Project>
